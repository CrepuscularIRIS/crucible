# Proma 部署配置。复制为 .env 后填写：cp .env.example .env
#
# .env 已在 .gitignore 里，永远不要提交它。

# ── 必填：模型服务 ───────────────────────────────────────────────────
# 阿里云百炼（DashScope）API Key，控制台：https://bailian.console.aliyun.com/
# Proma 的研究评测链路默认用 qwen3.7-plus 走 DashScope 的 OpenAI 兼容端点。
DASHSCOPE_API_KEY=

# ── 选填：其它模型服务 ───────────────────────────────────────────────
# 只在你要在 UI 里切到对应厂商时才需要；留空不影响启动。
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# 自建/代理网关（OpenAI 兼容）。留空则用各厂商官方地址。
# OPENAI_BASE_URL=

# ── 选填：运行时 ─────────────────────────────────────────────────────
# 端口只在与宿主已占用端口冲突时才需要改；改了要同步改 docker-compose.yml 的
# ports 映射，并保留 `127.0.0.1:` 前缀。
# PROMA_WEB_PORT=5173
# PROMA_WEB_BRIDGE_PORT=5174

# 无头 X 的分辨率。影响 Electron 主窗口大小，间接影响浏览器端首屏布局。
# PROMA_SCREEN=1920x1080x24

# 研究评测：benchmark 真值树在容器内的位置。只有跑 NeuronBench 评测才需要，
# 需自行把该目录挂进容器（compose 里加一条只读 volume）。
# NEURONBENCH_ROOT=/bench/neuronbench
