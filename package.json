{
  "name": "proma",
  "version": "0.1.2",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@proma/electron' dev",
    "electron:dev": "bun run --filter='@proma/electron' dev",
    "electron:build": "bun run --filter='@proma/electron' build",
    "electron:start": "bun run --filter='@proma/electron' start",
    "dist:mac": "bun run --filter='@proma/electron' dist:mac",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "dompurify": "^3.4.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "file:../oss/prime-agent/packages/agent",
    "@earendil-works/pi-ai": "file:../oss/prime-agent/packages/ai",
    "@earendil-works/pi-coding-agent": "file:../oss/prime-agent/packages/coding-agent",
    "@earendil-works/pi-tui": "file:../oss/prime-agent/packages/tui"
  },
  "trustedDependencies": [
    "@earendil-works/pi-coding-agent"
  ]
}
