 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-branch mr-1.5 size-3.5" aria-hidden="true"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>假设图</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-:R1b:-content-matrix" data-state="inactive" id="radix-:R1b:-trigger-matrix" class="inline-flex items-center justify-center whitespace-nowrap rounded-md px-3 py-1 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow" tabindex="-1" data-orientation="horizontal" data-radix-collection-item=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers mr-1.5 size-3.5" aria-hidden="true"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path></svg>证据矩阵</button></div><span class="workbench-revision">记录 #63</span></div><div class="workbench-scroll workbench-artifact-content"><section class="research-panel research-focus" aria-label="当前焦点"><div class="mb-2 text-[11px] text-muted-foreground">当前问题 · 当前焦点</div><h3 class="text-[13px] font-semibold">等待测量 P2</h3><div class="focus-lines"><p class="mt-1 text-[13px] leading-relaxed tabular-nums">P2：brief hyperpol 40ms 协议下真细胞 spike_count（reps=1）：ref/slow_na 校准 13.0、weakIh 校准 17.0、weakT 校准 20.0——三分 H3（无额外效应）/ H4（弱内向，慢 Ih flavour）/ H5（弱内向，快 T flavour）。</p><p class="mt-1 text-[13px] leading-relaxed tabular-nums">协议：brief hyperpol conditioning + test (-30 uA/40 ms, then +12 uA) · 重复 1 次</p><p class="mt-1 text-[13px] leading-relaxed tabular-nums">同协议候选仿真值 13–20（8 次；候选参数未记录，含参数差异）</p></div><p class="mt-1 flex items-start gap-1 text-[12px] text-amber-600 dark:text-amber-400" title="画布标记：宿主不强制"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert mt-0.5 size-3 shrink-0" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><span>M-reps · 只测 1 次就要分清 3 种解释</span></p></section><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:R1b:-trigger-probe" id="radix-:R1b:-content-probe" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 m-0 space-y-4 data-[state=inactive]:hidden" style="animation-duration:0s"><div class="flex flex-wrap items-center gap-2 text-[12px]"><label for=":R0:" class="text-muted-foreground">实验</label><select id=":R0:" class="workbench-select"><option value="P1">P1（3 次）</option><option value="P2" selected="">P2（1 次）</option></select><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-[transform,background-color,box-shadow,border-color,color] duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.97] [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 select-none hover:bg-accent/70 hover:text-accent-foreground h-8 rounded-sm px-3 ml-auto text-[11px]" type="button">查看版本</button></div><section class="min-w-0 overflow-hidden rounded-xl border border-border bg-background" aria-label="P2 实验产物"><header class="border-b border-border px-5 py-4"><div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-muted-foreground"><span class="font-mono">P2 · 实验对照</span><span class="">等待测量</span></div><h3 class="mt-3 text-base font-semibold leading-relaxed">brief hyperpol 40ms 协议下真细胞 spike_count（reps=1）：ref/slow_na 校准 13.0、weakIh 校准 17.0、weakT 校准 20.0——三分 H3（无额外效应）/ H4（弱内向，慢 Ih flavour）/ H5（弱内向，快 T flavour）。</h3><p class="mt-2 break-words text-xs leading-6 text-muted-foreground">brief hyperpol conditioning + test (-30 uA/40 ms, then +12 uA) · 重复次数 1</p><p class="break-words text-xs leading-6 text-muted-foreground">阻断剂：无</p></header><div class="px-5 py-4"><div class="flex flex-wrap items-start justify-between gap-3"><div><h4 class="text-sm font-medium">预测与实测</h4><p class="mt-1 text-[11px] text-muted-foreground">spike_count · 同一数轴比较</p></div><div class="text-right"><span class="text-[11px] text-muted-foreground">实测值</span><p class="font-mono text-xl font-semibold tabular-nums">—</p></div></div><div class="mt-4 overflow-x-auto"><svg class="block h-auto w-full min-w-[440px] text-foreground" viewBox="0 0 610 238" role="img" aria-labelledby=":Rjbb:-title :Rjbb:-desc"><title id=":Rjbb:-title">P2 各假设预测区间与实测值</title><desc id=":Rjbb:-desc">横线表示预测区间，菱形表示实测值。精确数值见下方数值表。落入区间不等于假设成立。</desc><g><line x1="92" x2="92" y1="18" y2="202" stroke="currentColor" stroke-opacity="0.1"></line><text x="92" y="222" text-anchor="start" fill="currentColor" font-size="11">10</text></g><g><line x1="321.99999999999994" x2="321.99999999999994" y1="18" y2="202" stroke="currentColor" stroke-opacity="0.1"></line><text x="321.99999999999994" y="222" text-anchor="middle" fill="currentColor" font-size="11">18</text></g><g><line x1="552" x2="552" y1="18" y2="202" stroke="currentColor" stroke-opacity="0.1"></line><text x="552" y="222" text-anchor="end" fill="currentColor" font-size="11">26</text></g><g><text x="12" y="40" fill="currentColor" font-size="13" font-weight="500">H3</text><line x1="92" x2="250.12499999999997" y1="36" y2="36" stroke="currentColor" stroke-opacity="0.2" stroke-width="12" stroke-linecap="round"></line><line x1="92" x2="250.12499999999997" y1="36" y2="36" stroke="currentColor" stroke-width="2"></line><line x1="92" x2="92" y1="29" y2="43" stroke="currentColor"></line><line x1="250.12499999999997" x2="250.12499999999997" y1="29" y2="43" stroke="currentColor"></line></g><g><text x="12" y="88" fill="currentColor" font-size="13" font-weight="500">H4</text><line x1="252.99999999999997" x2="333.4999999999999" y1="84" y2="84" stroke="currentColor" stroke-opacity="0.2" stroke-width="12" stroke-linecap="round"></line><line x1="252.99999999999997" x2="333.4999999999999" y1="84" y2="84" stroke="currentColor" stroke-width="2"></line><line x1="252.99999999999997" x2="252.99999999999997" y1="77" y2="91" stroke="currentColor"></line><line x1="333.4999999999999" x2="333.4999999999999" y1="77" y2="91" stroke="currentColor"></line></g><g><text x="12" y="136" fill="currentColor" font-size="13" font-weight="500">H5</text><line x1="336.375" x2="552" y1="132" y2="132" stroke="currentColor" stroke-opacity="0.2" stroke-width="12" stroke-linecap="round"></line><line x1="336.375" x2="552" y1="132" y2="132" stroke="currentColor" stroke-width="2"></line><line x1="336.375" x2="336.375" y1="125" y2="139" stroke="currentColor"></line><line x1="552" x2="552" y1="125" y2="139" stroke="currentColor"></line></g><line x1="92" x2="552" y1="202" y2="202" stroke="currentColor" stroke-opacity="0.3"></line></svg></div><div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-muted-foreground"><span>━ 预测区间</span><span>◆ 实测值</span><span>区间不是置信概率，也不代表科学结论</span></div><p class="mt-3 text-xs text-muted-foreground">测量尚未完成，图中只展示已记录的预测。</p><details class="mt-4 border-t border-border pt-3"><summary class="cursor-pointer text-xs font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring">查看精确数值与假设</summary><div class="mt-3 overflow-x-auto"><table class="w-full text-left text-xs tabular-nums"><caption class="sr-only">P2 预测与观测数值表</caption><thead class="text-muted-foreground"><tr><th class="py-2 font-normal">假设</th><th class="py-2 font-normal">预测区间</th><th class="py-2 font-normal">实测值</th></tr></thead><tbody><tr class="border-t border-border"><th scope="row" class="py-2 font-normal"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-[transform,background-color,box-shadow,border-color,color] duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.97] [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 select-none hover:bg-accent/70 hover:text-accent-foreground h-8 rounded-sm px-3 text-xs" aria-label="查看假设 H3">H3</button></th><td class="py-2">10 – 15.5</td><td class="py-2">未绘制</td></tr><tr class="border-t border-border"><th scope="row" class="py-2 font-normal"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-[transform,background-color,box-shadow,border-color,color] duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.97] [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 select-none hover:bg-accent/70 hover:text-accent-foreground h-8 rounded-sm px-3 text-xs" aria-label="查看假设 H4">H4</button></th><td class="py-2">15.6 – 18.4</td><td class="py-2">未绘制</td></tr><tr class="border-t border-border"><th scope="row" class="py-2 font-normal"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-[transform,background-color,box-shadow,border-color,color] duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.97] [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 select-none hover:bg-accent/70 hover:text-accent-foreground h-8 rounded-sm px-3 text-xs" aria-label="查看假设 H5">H5</button></th><td class="py-2">18.5 – 26</td><td class="py-2">未绘制</td></tr></tbody></table></div></details></div><footer class="border-t border-border bg-muted/20 px-5 py-4"><h4 class="text-sm font-medium">这一轮改变了什么</h4><p class="mt-2 text-xs leading-6 text-muted-foreground">尚未记录假设状态的变化。图中的区间比较不会自动生成科学判断。</p></footer></section></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:R1b:-trigger-map" id="radix-:R1b:-content-map" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 m-0 data-[state=inactive]:hidden"><section class="research-panel p-4" aria-label="假设与证据"><h2 class="mb-2 text-[13px] font-semibold">假设与证据</h2><p class="mb-4 text-[11px] leading-relaxed text-muted-foreground">派生关系未记录</p><div class="research-hypothesis-grid" role="group" aria-label="假设派生图"><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H1</span><span class="text-muted-foreground">◐ 收窄</span></span><span class="block text-[13px] font-medium leading-relaxed">ca_rebound 的额外电流是净内向、超极化…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">ca_rebound 的额外电流是净内向、超极化恢复可用性的瞬态电流（T型钙样或 Ih 样）：超极化条件刺激解除失活/激活该电流，释放后在去极化测试期产生额外内向驱动，使测试期峰数显著高于裸细胞基线（15.3±噪声）。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H2</span><span class="text-muted-foreground">? 有争议</span></span><span class="block text-[13px] font-medium leading-relaxed">ca_rebound 的额外电流是活动依赖的外向…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">ca_rebound 的额外电流是活动依赖的外向 K 流（适应型）：去极化条件刺激激活它，压制后续测试反应；超极化条件刺激后测试反应不高于基线。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H3</span><span class="text-muted-foreground">○ 未定</span></span><span class="block text-[13px] font-medium leading-relaxed">额外电流对常规步进与超极化释放协议无显著影响（效…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">额外电流对常规步进与超极化释放协议无显著影响（效应集中在基线通道的慢 Na 失活动力学，slow_na=true），即放电表观变化全部可由基线通道解释，无需额外反弹电流。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H4</span><span class="text-muted-foreground">○ 未定</span></span><span class="block text-[13px] font-medium leading-relaxed">H1 的 SCOPED 变体：ca_reboun…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">H1 的 SCOPED 变体：ca_rebound 存在小电导（g≈0.05-0.15）的弱内向电流（Ih 样或弱 T 型样），超极化恢复其可用性，释放后提供适度内向驱动——足以解释 P1 观测 17.33 相对基线 15.33 的 +2.0 弱增强，但不足以达到 H1 的强反弹带 [18,30]。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H5</span><span class="text-muted-foreground">○ 未定</span></span><span class="block text-[13px] font-medium leading-relaxed">H4 的快瞬态 flavour：弱内向电流是 T…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">H4 的快瞬态 flavour：弱内向电流是 T 型钙样瞬态流（快 m 激活 + 快 h 失活恢复，h_tau≈40ms），40ms 超极化即充分恢复可用性，释放时产生瞬态爆发驱动——预测 brief hyperpol 40ms 协议显著增强（+4 以上），而慢 Ih 样 flavour 在该协议无效应。</span></button></div></div></div></section></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:R1b:-trigger-matrix" id="radix-:R1b:-content-matrix" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 m-0 data-[state=inactive]:hidden"><section class="research-panel p-4" aria-label="证据矩阵"><h2 class="mb-4 text-[13px] font-semibold">假设与证据</h2><div class="overflow-x-auto"><table class="w-full border-collapse text-[12px]"><thead><tr class="text-left text-[11px] text-muted-foreground"><th class="py-1 pr-2 font-normal">假设（派生）</th><th class="py-1 pr-2 font-normal">状态</th><th class="whitespace-nowrap py-1 pr-2 font-normal"><button type="button" class="hover:underline">P1（3 次）</button></th><th class="whitespace-nowrap py-1 pr-2 font-normal"><button type="button" class="hover:underline">P2（1 次）</button></th></tr></thead><tbody><tr class="border-t border-border/60 align-top"><td class="py-1 pr-2" style="padding-left:0"><button type="button" class="text-left hover:underline"><span class="font-medium">H1</span> <span title="ca_rebound 的额外电流是净内向、超极化恢复可用性的瞬态电流（T型钙样或 Ih 样）：超极化条件刺激解除失活/激活该电流，释放后在去极化测试期产生额外内向驱动，使测试期峰数显著高于裸细胞基线（15.3±噪声）。">ca_rebound 的额外电流是净内向、超极化…</span></button></td><td class="whitespace-nowrap p