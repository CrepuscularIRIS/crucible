Color" stroke-opacity="0.1"></line><text x="92" y="174" text-anchor="start" fill="currentColor" font-size="11">12</text></g><g><line x1="322" x2="322" y1="18" y2="154" stroke="currentColor" stroke-opacity="0.1"></line><text x="322" y="174" text-anchor="middle" fill="currentColor" font-size="11">28.5</text></g><g><line x1="552" x2="552" y1="18" y2="154" stroke="currentColor" stroke-opacity="0.1"></line><text x="552" y="174" text-anchor="end" fill="currentColor" font-size="11">45</text></g><g><text x="12" y="40" fill="currentColor" font-size="13" font-weight="500">H2</text><line x1="92" x2="301.09090909090907" y1="36" y2="36" stroke="currentColor" stroke-opacity="0.2" stroke-width="12" stroke-linecap="round"></line><line x1="92" x2="301.09090909090907" y1="36" y2="36" stroke="currentColor" stroke-width="2"></line><line x1="92" x2="92" y1="29" y2="43" stroke="currentColor"></line><line x1="301.09090909090907" x2="301.09090909090907" y1="29" y2="43" stroke="currentColor"></line><path data-observed="26" d="M 287.1515151515151 29 l 7 7 -7 7 -7 -7 Z" fill="hsl(var(--primary))" stroke="hsl(var(--background))" stroke-width="1.5"></path></g><g><text x="12" y="88" fill="currentColor" font-size="13" font-weight="500">H3</text><line x1="315.030303030303" x2="552" y1="84" y2="84" stroke="currentColor" stroke-opacity="0.2" stroke-width="12" stroke-linecap="round"></line><line x1="315.030303030303" x2="552" y1="84" y2="84" stroke="currentColor" stroke-width="2"></line><line x1="315.030303030303" x2="315.030303030303" y1="77" y2="91" stroke="currentColor"></line><line x1="552" x2="552" y1="77" y2="91" stroke="currentColor"></line><path data-observed="26" d="M 287.1515151515151 77 l 7 7 -7 7 -7 -7 Z" fill="hsl(var(--primary))" stroke="hsl(var(--background))" stroke-width="1.5"></path></g><line x1="287.1515151515151" x2="287.1515151515151" y1="16" y2="154" stroke="hsl(var(--primary))" stroke-dasharray="4 5"></line><line x1="92" x2="552" y1="154" y2="154" stroke="currentColor" stroke-opacity="0.3"></line></svg></div><div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-muted-foreground"><span>━ 预测区间</span><span>◆ 实测值</span><span>区间不是置信概率，也不代表科学结论</span></div><details class="mt-4 border-t border-border pt-3"><summary class="cursor-pointer text-xs font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring">查看精确数值与假设</summary><div class="mt-3 overflow-x-auto"><table class="w-full text-left text-xs tabular-nums"><caption class="sr-only">P4 预测与观测数值表</caption><thead class="text-muted-foreground"><tr><th class="py-2 font-normal">假设</th><th class="py-2 font-normal">预测区间</th><th class="py-2 font-normal">实测值</th></tr></thead><tbody><tr class="border-t border-border"><th scope="row" class="py-2 font-normal"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-[transform,background-color,box-shadow,border-color,color] duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.97] [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 select-none hover:bg-accent/70 hover:text-accent-foreground h-8 rounded-sm px-3 text-xs" aria-label="查看假设 H2">H2</button></th><td class="py-2">12 – 27</td><td class="py-2">26</td></tr><tr class="border-t border-border"><th scope="row" class="py-2 font-normal"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-[transform,background-color,box-shadow,border-color,color] duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 active:scale-[0.97] [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 select-none hover:bg-accent/70 hover:text-accent-foreground h-8 rounded-sm px-3 text-xs" aria-label="查看假设 H3">H3</button></th><td class="py-2">28 – 45</td><td class="py-2">26</td></tr></tbody></table></div></details></div><footer class="border-t border-border bg-muted/20 px-5 py-4"><h4 class="text-sm font-medium">这一轮改变了什么</h4><ul class="mt-3 space-y-3"><li class="text-xs leading-6"><span class="font-medium">H2</span><span class="ml-2 font-mono text-[11px] text-muted-foreground">CONTESTED → SCOPED</span><p class="break-words text-muted-foreground">P4 观测 26.0 落入冻结 scope 带 [12,27]：与 slow_na(22)/AdaptK(24) 校准同混沌区、低于 ref(33) 7 个峰。第 4 个格子继续无证据支持『超极化释放增强』；适应型压抑流即使存在也与基线慢 Na 动力学在该精度不可分。收束：无生物学可检测的额外反弹电流。</p></li></ul></footer></section><section class="research-panel p-4"><h2 class="mb-3 text-[13px] font-medium">一次反馈改变</h2><ul class="space-y-2 text-[12px] leading-relaxed text-muted-foreground"><li>P1 → P2</li><li>原协议：hyperpol conditioning + depol test (-30 uA/250 ms, then +12 uA)；实测 17.33（3 次），落在 H3 的预测区间</li><li>因此：H1 → ◐ 收窄、H2 → ? 有争议</li><li>新协议：brief hyperpol conditioning + test (-30 uA/40 ms, then +12 uA)；目的：brief hyperpol 40ms 协议下真细胞 spike_count（reps=1）：ref/slow_na 校准 13.0、weakIh 校准 17.0、weakT 校准 20.0——三分 H3（无额外效应）/ H4（弱内向，慢 Ih flavour）/ H5（弱内向，快 T flavour）。</li></ul></section></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:R1b:-trigger-map" id="radix-:R1b:-content-map" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 m-0 data-[state=inactive]:hidden"><section class="research-panel p-4" aria-label="假设与证据"><h2 class="mb-2 text-[13px] font-semibold">假设与证据</h2><p class="mb-4 text-[11px] leading-relaxed text-muted-foreground">派生关系未记录</p><div class="research-hypothesis-grid" role="group" aria-label="假设派生图"><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H1</span><span class="text-muted-foreground">◐ 收窄</span></span><span class="block text-[13px] font-medium leading-relaxed">ca_rebound 的额外电流是净内向、超极化…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">ca_rebound 的额外电流是净内向、超极化恢复可用性的瞬态电流（T型钙样或 Ih 样）：超极化条件刺激解除失活/激活该电流，释放后在去极化测试期产生额外内向驱动，使测试期峰数显著高于裸细胞基线（15.3±噪声）。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H2</span><span class="text-muted-foreground">◐ 收窄</span></span><span class="block text-[13px] font-medium leading-relaxed">ca_rebound 的额外电流是活动依赖的外向…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">ca_rebound 的额外电流是活动依赖的外向 K 流（适应型）：去极化条件刺激激活它，压制后续测试反应；超极化条件刺激后测试反应不高于基线。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H3</span><span class="text-muted-foreground">✓ 得到支持</span></span><span class="block text-[13px] font-medium leading-relaxed">额外电流对常规步进与超极化释放协议无显著影响（效…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">额外电流对常规步进与超极化释放协议无显著影响（效应集中在基线通道的慢 Na 失活动力学，slow_na=true），即放电表观变化全部可由基线通道解释，无需额外反弹电流。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H4</span><span class="text-muted-foreground">◐ 收窄</span></span><span class="block text-[13px] font-medium leading-relaxed">H1 的 SCOPED 变体：ca_reboun…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">H1 的 SCOPED 变体：ca_rebound 存在小电导（g≈0.05-0.15）的弱内向电流（Ih 样或弱 T 型样），超极化恢复其可用性，释放后提供适度内向驱动——足以解释 P1 观测 17.33 相对基线 15.33 的 +2.0 弱增强，但不足以达到 H1 的强反弹带 [18,30]。</span></button></div></div><div class="research-hypothesis-branch"><div><button type="button" class="research-hypothesis-node" aria-pressed="false"><span class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[11px]"><span class="flex items-center gap-1 font-mono text-muted-foreground">H5</span><span class="text-destructive">✕ 被否定</span></span><span class="block text-[13px] font-medium leading-relaxed">H4 的快瞬态 flavour：弱内向电流是 T…</span><span class="mt-2 line-clamp-3 text-[12px] leading-relaxed text-muted-foreground">H4 的快瞬态 flavour：弱内向电流是 T 型钙样瞬态流（快 m 激活 + 快 h 失活恢复，h_tau≈40ms），40ms 超极化即充分恢复可用性，释放时产生瞬态爆发驱动——预测 brief hyperpol 40ms 协议显著增强（+4 以上），而慢 Ih 样 flavour 在该协议无效应。</span></button></div></div></div></section></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-:R1b:-trigger-matrix" id="radix-:R1b:-content-matrix" tabindex="0" class="ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 m-0 data-[state=inactive]:hidden"><section class="research-panel p-4" aria-label="证据矩阵"><h2 class="mb-4 text-[13px] font-semibold">假设与证据</h2><div class="overflow-x-auto"><table class="w-full border-collapse text-[12px]"><thead><tr class="text-left text-[11px] text-muted-foreground"><th class="py-1 pr-2 font-normal">假设（派生）</th><th class="py-1 pr-2 font-normal">状态</th><th class="whitespace-nowrap py-1 pr-2 font-normal"><button type="button" class="hover:underline">P1（3 次）</button></th><th class="whitespace-nowrap py-1 pr-2 font-normal"><button type="button" class="hover:underline">P2（1 次）</button></t